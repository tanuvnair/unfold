# Copy to .env:  cp .env.example .env
# Loaded by make, core/cmd/api, and web/vite.config.ts.

# --- API (make api / make serve) ---
# make runs the API with CWD=core/, so this path is relative to core/.
# UNFOLD_API_ADDR=127.0.0.1:8080   # overrides HOST+PORT when set
UNFOLD_API_HOST=127.0.0.1
UNFOLD_API_PORT=8080
UNFOLD_API_CONFIG=configs/banks.json

# CORS for Vite dev (http://localhost:5173). Unused for make serve (same origin).
UNFOLD_API_CORS_ORIGIN=http://localhost:5173

# --- Web (make web) ---
UNFOLD_WEB_HOST=localhost
UNFOLD_WEB_PORT=5173

# Where the *browser* sends /api (baked into the JS bundle).
# Leave empty for normal use: page and API share one origin
#   make serve → http://127.0.0.1:8080/api
#   make web   → http://localhost:5173/api  (Vite then forwards; see below)
# Only set this if the UI is hosted on a different host than the API.
# UNFOLD_WEB_API_BASE=https://api.example.com

# Where *Vite* forwards /api during `make web` (dev only, never in the browser).
# Only used when WEB_API_BASE is empty. Defaults to HOST:PORT above.
# UNFOLD_API_PROXY_TARGET=http://127.0.0.1:8080
